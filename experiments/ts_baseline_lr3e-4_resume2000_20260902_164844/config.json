{
   "data": {
      "train_path": "data/tinystories_train_tokens.npy",
      "val_path": "data/tinystories_valid_tokens.npy"
   },
   "model": {
      "vocab_size": 10000,
      "context_length": 256,
      "num_layers": 4,
      "d_model": 512,
      "num_heads": 16,
      "d_ff": 1344,
      "rope_theta": 10000.0
   },
   "optimizer": {
      "lr_max": 0.0003,
      "lr_min": 3e-05,
      "warmup_steps": 100,
      "cosine_steps": 5000,
      "betas": [
         0.9,
         0.95
      ],
      "eps": 1e-08,
      "weight_decay": 0.1,
      "max_grad_norm": 1.0
   },
   "training": {
      "run_name": "ts_baseline_lr3e-4_resume2000",
      "experiments_dir": "experiments",
      "batch_size": 32,
      "num_steps": 5000,
      "eval_interval": 100,
      "eval_batches": 10,
      "checkpoint_interval": 1000,
      "resume_checkpoint": "checkpoints/tinystories.pt/step_2000.pt",
      "device": "cuda"
   }
}
